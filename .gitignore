*~

# Logs and databases
*.log
*.sqlite

# Local configuration overrides (keep config.php in repo with defaults)
api/config.local.php
.env

# User uploaded media (keep folders via .gitkeep, ignore live uploaded media)
uploads/photos/*
!uploads/photos/.gitkeep
uploads/documents/*
!uploads/documents/.gitkeep
uploads/videos/*
!uploads/videos/.gitkeep

# Temporary archives
*.zip
*.tar.gz
*.rar
